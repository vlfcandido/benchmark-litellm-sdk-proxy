
# SDK (direct)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
SDK_MODEL=gpt-4o-mini

# Proxy
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_PROXY_KEY=sk-proxy-123
PROXY_MODEL=openai/gpt-4o-mini

# General
TEMPERATURE=0.2
MAX_TOKENS=512
REQUEST_TIMEOUT=60


# ===========================================
# EXEMPLOS DE CONFIGURAÇÃO POR CENÁRIO
# ===========================================

# Para benchmarks de desenvolvimento rápido
# REQUESTS=50
# CONCURRENCY=5

# Para benchmarks de stress test
# REQUESTS=1000
# CONCURRENCY=50

# Para benchmarks de produção
# REQUESTS=200
# CONCURRENCY=20